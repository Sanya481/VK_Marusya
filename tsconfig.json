{
  // явно указывает, что этот файл не содержит исходных кодов напрямую. Все файлы включены через references.
  "files": [],
  "compilerOptions": {
    "skipLibCheck": true
    // ... остальные настройки
  },
  // список подпроектов, которые TypeScript должен собрать вместе. При компиляции (tsc --build) будут обработаны оба подпроекта. Позволяет переиспользовать типы между частями проекта.
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
