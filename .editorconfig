# https://editorconfig.org/
# EditorConfig — стандарт для настройки редакторов кода (отступы, кодировка, переносы)
# Работает на уровне IDE, чтобы у всех разработчиков были одинаковые базовые настройки

# root = true означает, что это корневой файл EditorConfig
# Выше него нет других .editorconfig — не нужно искать в родительских папках
root = true

# Правила для всех файлов ([*] — глобальный паттерн)
[*]
# Кодировка UTF-8 — чтобы не было проблем с кириллицей и эмодзи на разных ОС
charset = utf-8

# Переносы строк в стиле Unix/Linux/macOS (\n)
# В Windows используют \r\n — явно указываем, чтобы не было расхождений в git
end_of_line = lf

# Добавлять пустую строку в конец файла (требование POSIX-стандарта)
insert_final_newline = true

# Удалять пробелы в конце строк — они не видны, но создают шум в git diff
trim_trailing_whitespace = true

# Использовать пробелы вместо табов — табы по-разному отображаются в редакторах (4 или 8 символов)
indent_style = space

# Размер отступа — 2 пробела (стандарт для JavaScript/TypeScript)
indent_size = 2

# Правила для JavaScript/TypeScript файлов
[*.{js,ts,jsx,tsx}]
indent_size = 2

# Правила для JSON файлов
[*.json]
indent_size = 2

# Правила для Markdown файлов
[*.md]
# В Markdown пробелы в конце строки создают перенос (<br>) — не удаляем их
trim_trailing_whitespace = false
